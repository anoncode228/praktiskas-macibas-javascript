:8000 {
    bind 127.0.0.1
    root * .
    encode gzip

    @assets path /images/* /css/* /js/* /favicon.ico
    header @assets Cache-Control "public, max-age=604800"

    @html path / /index.html
    header @html Cache-Control "no-cache"

    @https header X-Forwarded-Proto https
    header @https Strict-Transport-Security "max-age=31536000"

    header {
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'sha256-RJcWRkW2JqXiWMjaa51V5t4I+IU0gp3M5VeqR9cCmIQ='; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'"
        Cross-Origin-Opener-Policy "same-origin"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
    }

    @public path / /index.html /favicon.ico /images/* /css/style.css /js/script.js
    handle @public {
        file_server
    }
    handle {
        respond 404
    }
}
